[Unit]
Description=easy-onion-gitea Compose stack (Gitea onion service)
Documentation=file:///opt/easy-onion-gitea/README.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/easy-onion-gitea
EnvironmentFile=/opt/easy-onion-gitea/config.env
ExecStart=/usr/bin/docker compose --env-file /opt/easy-onion-gitea/config.env up -d --remove-orphans
ExecStop=/usr/bin/docker compose --env-file /opt/easy-onion-gitea/config.env down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
