# Tor configuration for easy-onion-gitea (v3 onion only).
User debian-tor
DataDirectory /var/lib/tor
PidFile /var/lib/tor/tor.pid

# Reachable only on Compose networks; not published on the host.
SocksPort 0.0.0.0:9050 IsolateDestAddr IsolateDestPort

HiddenServiceDir /var/lib/tor/hidden_service
HiddenServiceVersion 3
HiddenServicePort 80 gitea:3000

Log notice stdout
RunAsDaemon 0
SafeLogging 1
