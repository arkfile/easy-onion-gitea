# Tor configuration for easy-onion-gitea (v3 onion only).
# Do not set User here: the image already runs as debian-tor (USER), and
# User + cap_drop ALL fails with "Error setting groups ... Operation not permitted".
DataDirectory /var/lib/tor
PidFile /var/lib/tor/tor.pid

# Reachable only on Compose networks; not published on the host.
SocksPort 0.0.0.0:9050 IsolateDestAddr IsolateDestPort

HiddenServiceDir /var/lib/tor/hidden_service
HiddenServiceVersion 3
# Tor requires an IP here (not a Docker DNS name). Matches compose gitea ipv4_address.
HiddenServicePort 80 172.30.0.10:3000

Log notice stdout
RunAsDaemon 0
SafeLogging 1
